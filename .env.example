# yfinance-mcp configuration.
#
# yfinance needs NO credentials, NO API key, and NO OAuth — it scrapes the
# public Yahoo Finance endpoints. This file therefore only holds optional
# tuning knobs. Copy it to `.env` (git-ignored) if you want to override a
# default; otherwise you can run the server with no `.env` at all.
#
# IMPORTANT: This server is READ-ONLY market data and its use of yfinance is
# a Terms-of-Service GRAY AREA. See docs/SECURITY.md before deploying.

# Optional: derived-history cache of fetched frames.
# Cache is OPT-IN (default DISABLED). Set to true/1/yes/on to enable.
# YFINANCE_CACHE_ENABLED=true
# YFINANCE_CACHE_BYPASS=0

# Optional: pluggable cache backend (default: memory).
#   memory     — in-process, zero external dependency (default). Keeps no
#                durable history (snapshot writes report 0 persisted rows).
#   clickhouse — durable derived-history persistence; requires the extra
#                `pip install yfinance-mcp[clickhouse]` + a reachable
#                ClickHouse. Falls back to memory on any unknown value.
# YFINANCE_CACHE_BACKEND=memory
# YFINANCE_CLICKHOUSE_URL=clickhouse://user:pass@host:8123/db  # pragma: allowlist secret

# Optional: per-call timeout in seconds for the asyncio.to_thread yfinance
# call (default: 30).
# YFINANCE_TIMEOUT_SECONDS=30

# Optional: stderr log level (default: WARNING).
# LOG_LEVEL=WARNING
