# ----------------------------------------------------------------------------
# yfinance-mcp project-specific entries
# ----------------------------------------------------------------------------

# Secrets / runtime artifacts. yfinance needs NO API key / token, but we keep
# the .env block for optional config (cache toggles, throttle interval) and to
# stay consistent with the sibling MCP repos.
.env
.env.*
!.env.example
.secrets.baseline.local

# Runtime state (must NEVER be committed; production data lives outside repo)
usage.jsonl
logs/

# yfinance / pandas / numpy scratch artifacts — never commit cached frames.
*.pkl
*.parquet
*.feather
*.duckdb
*.duckdb.*

# CRITICAL: keep uv.lock in repository (reverse rule, avoid being swallowed
# by any earlier *.lock glob).
!uv.lock
